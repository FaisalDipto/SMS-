<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMSWeb Gateway"
            android:textColor="#123D3A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Android phone SMS gateway for the Raspberry Pi crisis service"
            android:textColor="#55716D"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/gateway_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#DCFCE7"
            android:padding="16dp"
            android:text="Gateway ready"
            android:textColor="#166534"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Raspberry Pi local URL"
            android:textColor="#17312F"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pi_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.43.1:8080"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/save_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save Pi URL" />

        <Button
            android:id="@+id/check_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Check connection" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="The gateway receives REQ messages by SMS, forwards them to the Pi over the local hotspot, and sends the Pi response back to the user."
            android:textColor="#55716D"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
